# ========================================
# SEC Filings Dashboard - Environment Variables
# ========================================
# Copy this file to .env and update with your values
# NEVER commit the .env file to version control

# ========================================
# Application Settings
# ========================================
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production-min-32-chars
API_PORT=8000
FRONTEND_PORT=3000

# ========================================
# Database (PostgreSQL)
# ========================================
POSTGRES_USER=secfilings
POSTGRES_PASSWORD=secfilings_dev
POSTGRES_DB=secfilings
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Full database URL (constructed from above values)
DATABASE_URL=postgresql+asyncpg://secfilings:secfilings_dev@postgres:5432/secfilings

# ========================================
# Redis (Cache & Job Queue)
# ========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_password
REDIS_DB=0
REDIS_URL=redis://:redis_dev_password@redis:6379/0

# ========================================
# Elasticsearch (Full-text Search)
# ========================================
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX_PREFIX=sec_filings

# ========================================
# SEC EDGAR API Configuration
# ========================================
# IMPORTANT: SEC requires a User-Agent header with your contact info
# Format: "YourCompanyName YourName (your.email@domain.com)"
SEC_API_USER_AGENT=YourCompanyName YourName (your.email@example.com)
SEC_API_BASE_URL=https://www.sec.gov
SEC_API_RATE_LIMIT=10
SEC_API_RATE_PERIOD=1

# ========================================
# OAuth Authentication (Google)
# ========================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ========================================
# OAuth Authentication (GitHub - Optional)
# ========================================
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# ========================================
# Email Configuration (SendGrid)
# ========================================
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=SEC Filings Dashboard

# ========================================
# Email Configuration (SMTP Alternative)
# ========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_TLS=True
SMTP_SSL=False

# ========================================
# Celery Configuration
# ========================================
CELERY_BROKER_URL=redis://:redis_dev_password@redis:6379/0
CELERY_RESULT_BACKEND=redis://:redis_dev_password@redis:6379/0
CELERY_TASK_ALWAYS_EAGER=False
CELERY_TASK_EAGER_PROPAGATES=False

# ========================================
# Frontend Configuration
# ========================================
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=SEC Filings Dashboard
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ========================================
# Logging Configuration
# ========================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_PATH=./logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ========================================
# CORS Configuration
# ========================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=True

# ========================================
# Rate Limiting
# ========================================
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ========================================
# File Storage (Local/S3)
# ========================================
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./storage
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=sec-filings-storage
AWS_REGION=us-east-1

# ========================================
# Monitoring & Analytics (Optional)
# ========================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# ========================================
# Feature Flags
# ========================================
FEATURE_REAL_TIME_ALERTS=True
FEATURE_AI_SUMMARIES=True
FEATURE_EXPORT_PDF=True
FEATURE_ADVANCED_SEARCH=True

# ========================================
# Background Job Settings
# ========================================
EDGAR_SYNC_INTERVAL_MINUTES=15
ALERT_CHECK_INTERVAL_MINUTES=5
INDEX_BATCH_SIZE=100
MAX_CONCURRENT_DOWNLOADS=5

# ========================================
# API Keys (Optional Services)
# ========================================
# OpenAI API (for AI summaries feature)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4

# Anthropic API (alternative for AI summaries)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-sonnet-20240229
